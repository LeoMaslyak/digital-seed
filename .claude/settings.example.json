{
  "_README": "Copy this file to .claude/settings.json (which is gitignored) and fill in your own values. NEVER paste real secrets (API keys, OAuth tokens, database passwords) into this example file — it is committed to git. Keep real secrets in .env only and reference them from there.",
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  },
  "mcpServers": {
    "seed-memory": {
      "command": "bun",
      "args": [
        "run",
        "mcp/memory-server/src/index.ts"
      ],
      "env": {}
    },
    "seed-tasks": {
      "command": "bun",
      "args": [
        "run",
        "mcp/tasks-server/src/index.ts"
      ],
      "env": {}
    },
    "seed-rag": {
      "command": "bun",
      "args": [
        "run",
        "mcp/rag-server/src/index.ts"
      ],
      "env": {}
    },
    "seed-graph": {
      "command": "bun",
      "args": [
        "run",
        "mcp/graph-server/src/index.ts"
      ],
      "env": {}
    }
  }
}
