{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "LS"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  },
  "mcpServers": {
    "seed-memory": {
      "command": "bun",
      "args": [
        "run",
        "mcp/memory-server/src/index.ts"
      ],
      "env": {}
    },
    "seed-tasks": {
      "command": "bun",
      "args": [
        "run",
        "mcp/tasks-server/src/index.ts"
      ],
      "env": {}
    },
    "seed-rag": {
      "command": "bun",
      "args": [
        "run",
        "mcp/rag-server/src/index.ts"
      ],
      "env": {}
    },
    "seed-graph": {
      "command": "bun",
      "args": [
        "run",
        "mcp/graph-server/src/index.ts"
      ],
      "env": {}
    }
  }
}
