# Secrets & config
.env
.env.*
config/config.yaml
.claude/settings.json
config/digest.yaml

# User data (personal, never committed)
# Ignore the entire user/ tree, then allow-list ONLY the pristine templates
# and this directory's README. Live personal files the kit fills in place
# (USER/GOALS/MEMORY/PREFERENCES/COMPASS/DOMAINS/ANTI-GOALS) stay ignored.
user/**
!user/README.md
!user/**/*.template.md

# Runtime data
data/
logs/

# Dependencies
node_modules/
.bun/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Export archives
exports/

# Config (personal)
config/config.yaml
config/autonomy.yaml
config/token-budget.json

# Collaboration space is git-tracked (shared content)
# Un-ignore collab/ explicitly since data/ is ignored above
!collab/
!collab/**
